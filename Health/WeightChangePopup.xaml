<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Health.WeightChangePopup"
             Color="Transparent">
    <Border StrokeShape="RoundRectangle 16" BackgroundColor="White">
        <VerticalStackLayout Padding="20" Spacing="10">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="Изменить вес" FontAttributes="Bold" FontSize="24"/>
                <Image Source="pencil.png" WidthRequest="20" HeightRequest="20"/>
            </HorizontalStackLayout>
            <Entry x:Name="WeightEntry"
                   Placeholder="Введите вес(кг)"
                   Keyboard="Numeric"/>
            <Button Text="Подтвердить"
                    BackgroundColor="#0080ff"
                    TextColor="White"
                    FontSize="18"
                    CornerRadius="8"
                    Margin="0,10,0,0"
                    Clicked="OnConfirmClicked"/>
        </VerticalStackLayout>
    </Border>
</toolkit:Popup>