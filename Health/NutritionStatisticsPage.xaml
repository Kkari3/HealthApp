<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:cal="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar" 
             xmlns:vms="clr-namespace:Health.ViewModels;assembly=Health"
             x:Class="Health.NutritionStatisticsPage">
    <ContentPage.BindingContext>
        <vms:ViewModel/>
    </ContentPage.BindingContext>
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout>
                <Label Text="График веса за 7 дней" FontSize="20" Margin="10" HorizontalOptions="Center" FontAttributes="Bold"/>


                <lvc:CartesianChart
                    Series="{Binding Series}"
                    XAxes="{Binding XAxes}"
                    YAxes="{Binding YAxes}"
                    HeightRequest="300">
                </lvc:CartesianChart>

                <BoxView HeightRequest="1"
                     Color="#CCCCCC"
                     HorizontalOptions="Fill"
                     Margin="0,26,0,0" />

                <Grid ColumnDefinitions="*,Auto" Margin="10,60,10,0">
                    <Label 
                        Text="БЖУ за 7 дней" 
                        FontSize="20" 
                        Margin="0,0,0,0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        FontAttributes="Bold"
                        Grid.Column="0"/>

                    <Button
                        Text="{Binding IsCaloriesMode, Converter={StaticResource BoolToTextConverter}, ConverterParameter='граммы|ккал'}"
                        Command="{Binding ToggleNutritionModeCommand}"
                        Margin="0,0,0,0"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Grid.Column="1"
                        FontSize="13"
                        Padding="8,4"
                        CornerRadius="6"
                        BackgroundColor="#2196F3"
                        TextColor="White"/>
                </Grid>
                

                <lvc:CartesianChart
                    Series="{Binding NutritionSeries}"
                    XAxes="{Binding NutritionXAxes}"
                    YAxes="{Binding NutritionYAxes}"
                    LegendPosition="Bottom"
                    HeightRequest="300" />

                <BoxView HeightRequest="1"
                         Color="#CCCCCC"
                         HorizontalOptions="Fill"
                         Margin="0,26,0,0" />

                <!--<cal:Calendar
                    Events="{Binding Events}"
                    EventIndicatorType="BottomDot">
                    <cal:Calendar.EventTemplate>
                        <DataTemplate>
                            <Grid Padding="0">
                                <BoxView 
                                    WidthRequest="6"
                                    HeightRequest="6"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    Color="{Binding Color}"/>
                            </Grid>
                        </DataTemplate>
                    </cal:Calendar.EventTemplate>
                </cal:Calendar>-->

            </VerticalStackLayout>
        </ScrollView>

        <Button Text="Добавить изменение в весе"
                BackgroundColor="#4CAF50"
                TextColor="White"
                FontSize="18"
                CornerRadius="8"
                Margin="20"
                Grid.Row="1"
                Clicked="OnWeightChange"/>
    </Grid>
</ContentPage>


